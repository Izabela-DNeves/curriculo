---
import { cv, contact, type Lang } from '../data/cv';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = cv[lang];

const journey = lang === 'pt'
  ? [
      { place: 'Estados Unidos', code: 'USA', what: 'Trabalho · cuidadora infantil', when: '2024 · 2026' },
      { place: 'Seul, Coreia do Sul', code: 'ICN', what: 'Intercâmbio · Kyung Hee University', when: '2024 — 2025' },
      { place: 'Belo Horizonte', code: 'CNF', what: 'Marketing · Quartel Design', when: '2025 — 2026' },
    ]
  : [
      { place: 'United States', code: 'USA', what: 'Work · childcare provider', when: '2024 · 2026' },
      { place: 'Seoul, South Korea', code: 'ICN', what: 'Study abroad · Kyung Hee University', when: '2024 — 2025' },
      { place: 'Belo Horizonte', code: 'CNF', what: 'Marketing · Quartel Design', when: '2025 — 2026' },
    ];
const journeyTitle = lang === 'pt' ? 'Rota até aqui' : 'The journey so far';
---

<header class="no-print sticky top-0 z-20 border-b border-line/80 bg-paper/85 backdrop-blur">
  <nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 md:px-8">
    <a href="#top" class="font-display text-lg font-medium tracking-tight">{contact.name}</a>
    <div class="hidden items-center gap-6 text-sm text-muted md:flex">
      <a class="hover:text-ink" href="#perfil">{t.nav.about}</a>
      <a class="hover:text-ink" href="#experiencia">{t.nav.experience}</a>
      <a class="hover:text-ink" href="#idiomas">{t.nav.languages}</a>
      <a class="hover:text-ink" href="#formacao">{t.nav.education}</a>
      <a class="hover:text-ink" href="#contato">{t.nav.contact}</a>
    </div>
    <div class="flex items-center gap-2">
      <a href={import.meta.env.BASE_URL.replace(/\/$/, '') + t.nav.switchHref} class="rounded-full border border-line px-3 py-1.5 text-xs font-semibold tracking-wide hover:border-ink" aria-label={lang === 'pt' ? 'Read in English' : 'Ler em português'}>{t.nav.switch}</a>
      <button type="button" data-print class="rounded-full bg-ink px-4 py-1.5 text-xs font-semibold text-paper hover:bg-sky">{t.nav.print}</button>
    </div>
  </nav>
</header>

<main id="top">
  <!-- HERO -->
  <section class="print-tight mx-auto max-w-6xl px-4 pt-14 pb-12 md:px-8 md:pt-20 md:pb-16">
    <div class="grid items-start gap-10 lg:grid-cols-[1.35fr_1fr] lg:gap-14">
      <div>
        <p class="eyebrow">{t.hero.eyebrow}</p>
        <h1 class="mt-5 font-display text-5xl font-medium leading-[1.02] tracking-tight md:text-7xl">
          Izabela <br />Dutra Neves
          <span class="ml-1 align-top font-kr text-lg font-medium text-accent md:text-xl" lang="ko" title="Izabela em coreano">{contact.nameKr}</span>
        </h1>
        <p class="mt-6 max-w-xl font-display text-2xl leading-snug text-sky italic md:text-[1.7rem]">{t.hero.headline}</p>
        <p class="mt-5 max-w-xl text-base leading-relaxed text-muted md:text-lg">{t.hero.intro}</p>
        <div class="no-print mt-8 flex flex-wrap items-center gap-3">
          <a href="#contato" class="inline-flex items-center gap-2 rounded-full bg-accent px-6 py-3 text-sm font-semibold text-white shadow-sm hover:brightness-110">
            {t.hero.ctaPrimary}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a href={contact.linkedin} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-full border border-ink/20 px-6 py-3 text-sm font-semibold hover:border-ink"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/></svg>{t.hero.ctaLinkedin}</a>
        </div>
        <p class="mt-6 inline-flex items-center gap-2 rounded-full bg-card px-3 py-1.5 text-xs font-medium text-muted ring-1 ring-line">
          <span class="relative flex h-2 w-2"><span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-60"></span><span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span></span>
          {t.hero.available} · {contact.city}
        </p>
      </div>

      <!-- Boarding-pass style journey card -->
      <aside class="avoid-break print:hidden relative overflow-hidden rounded-3xl bg-ink text-paper shadow-lg">
        <div class="flex items-center justify-between border-b border-white/10 px-6 py-4">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-white/60">{journeyTitle}</p>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" class="text-accent" aria-hidden="true"><path d="M21 16v-2l-8-5V3.5a1.5 1.5 0 0 0-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5z"/></svg>
        </div>
        <ol class="relative px-6 py-5">
          <span class="absolute top-9 bottom-9 left-[2.1rem] w-px border-l border-dashed border-white/25" aria-hidden="true"></span>
          {journey.map((j, i) => (
            <li class="relative flex gap-4 py-3">
              <span class={`relative z-10 mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full ${i === journey.length - 1 ? 'bg-accent' : 'bg-paper'}`}>
                <span class={`h-1.5 w-1.5 rounded-full ${i === journey.length - 1 ? 'bg-paper' : 'bg-ink'}`}></span>
              </span>
              <div class="flex-1">
                <div class="flex items-baseline justify-between gap-3">
                  <p class="font-display text-lg leading-tight">{j.place}</p>
                  <p class="font-mono text-xs tracking-widest text-white/50">{j.code}</p>
                </div>
                <p class="mt-0.5 text-sm text-white/70">{j.what}</p>
                <p class="mt-0.5 text-xs text-white/45">{j.when}</p>
              </div>
            </li>
          ))}
        </ol>
        <div class="flex items-center justify-between border-t border-dashed border-white/20 bg-white/5 px-6 py-4">
          <div>
            <p class="text-[10px] uppercase tracking-[0.2em] text-white/50">{lang === 'pt' ? 'Destino' : 'Destination'}</p>
            <p class="font-display text-base">{lang === 'pt' ? 'Relações Internacionais' : 'International Relations'}</p>
          </div>
          <div class="flex gap-[3px]" aria-hidden="true">
            {[3,1,2,1,3,2,1,1,3,1,2,3,1,2].map((w) => <span class="h-8 bg-white/70" style={`width:${w}px`}></span>)}
          </div>
        </div>
      </aside>
    </div>

    <dl class="mt-14 grid grid-cols-2 gap-px overflow-hidden rounded-2xl bg-line ring-1 ring-line md:grid-cols-4">
      {t.stats.map((s) => (
        <div class="bg-card px-5 py-6">
          <dt class="sr-only">{s.label}</dt>
          <dd class="font-display text-3xl font-medium tracking-tight text-ink md:text-4xl">{s.value}</dd>
          <dd class="mt-2 text-sm leading-snug text-muted">{s.label}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- PERFIL -->
  <section id="perfil" class="print-tight scroll-mt-20 border-t border-line bg-card">
    <div class="mx-auto max-w-6xl px-4 py-16 md:px-8 md:py-24">
      <div class="grid gap-10 lg:grid-cols-[1fr_1.4fr]">
        <div>
          <p class="eyebrow">{t.about.eyebrow}</p>
          <h2 class="section-title mt-3">{t.about.title}</h2>
        </div>
        <p class="text-lg leading-relaxed text-muted">{t.about.text}</p>
      </div>
      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {t.about.pillars.map((p, i) => (
          <article class="rounded-2xl border border-line bg-paper p-6">
            <p class="font-display text-sm text-accent">0{i + 1}</p>
            <h3 class="mt-3 font-display text-xl font-medium">{p.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted">{p.text}</p>
          </article>
        ))}
      </div>
      <div class="mt-10 flex flex-wrap items-center gap-2">
        <span class="mr-2 text-sm font-semibold">{t.about.interestsTitle}:</span>
        {t.about.interests.map((x) => <span class="rounded-full bg-sky-soft px-3 py-1 text-sm text-sky">{x}</span>)}
      </div>
    </div>
  </section>

  <!-- EXPERIÊNCIA -->
  <section id="experiencia" class="print-tight scroll-mt-20 border-t border-line">
    <div class="mx-auto max-w-6xl px-4 py-16 md:px-8 md:py-24">
      <p class="eyebrow">{t.experience.eyebrow}</p>
      <h2 class="section-title mt-3">{t.experience.title}</h2>
      <ol class="mt-12 space-y-6">
        {t.experience.items.map((e) => (
          <li>
            <article class="grid gap-4 rounded-2xl border border-line bg-card p-6 md:grid-cols-[13rem_1fr] md:gap-8 md:p-8">
              <div>
                <p class="flex items-center gap-2 font-display text-2xl font-semibold leading-tight text-ink">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="shrink-0 text-accent" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg>
                  {e.country}
                </p>
                {e.city && <p class="mt-0.5 text-sm text-muted">{e.city}</p>}
                <span class="mt-4 inline-block rounded-full bg-ink px-3 py-1 text-[11px] font-semibold uppercase tracking-wider text-paper">{e.tag}</span>
                <p class="mt-3 text-sm font-medium text-ink">{e.period}</p>
              </div>
              <div>
                <h3 class="font-display text-2xl font-medium leading-tight">{e.role}</h3>
                <p class="mt-1 text-sky font-medium">{e.org}</p>
                <ul class="mt-4 space-y-2.5">
                  {e.bullets.map((b) => (
                    <li class="flex gap-3 text-[15px] leading-relaxed text-muted">
                      <span class="mt-2.5 h-1 w-3 shrink-0 rounded bg-accent" aria-hidden="true"></span>
                      <span>{b}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- IDIOMAS -->
  <section id="idiomas" class="print-tight scroll-mt-20 border-t border-line bg-card">
    <div class="mx-auto max-w-6xl px-4 py-16 md:px-8 md:py-24">
      <p class="eyebrow">{t.languages.eyebrow}</p>
      <h2 class="section-title mt-3">{t.languages.title}</h2>
      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {t.languages.items.map((l, i) => (
          <article class={`flex flex-col rounded-2xl p-6 md:p-7 ${i === 0 ? 'border border-line bg-paper' : 'bg-ink text-paper'}`}>
            <p class={`text-xs font-semibold uppercase tracking-[0.18em] ${i === 0 ? 'text-muted' : 'text-white/60'}`}>{l.level}</p>
            <h3 class="mt-3 font-display text-3xl font-medium">{l.name}</h3>
            {l.cert ? (
              <div class="mt-auto pt-8">
                <span class="inline-block rounded-md bg-accent px-2.5 py-1 text-xs font-semibold tracking-wide text-white">{l.cert}</span>
                <p class="mt-3 text-sm text-white/75">{l.detail}</p>
              </div>
            ) : (
              <p class="mt-auto pt-8 text-sm text-muted">{lang === 'pt' ? 'Língua materna' : 'Mother tongue'}</p>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- FORMAÇÃO -->
  <section id="formacao" class="print-tight scroll-mt-20 border-t border-line">
    <div class="mx-auto max-w-6xl px-4 py-16 md:px-8 md:py-24">
      <p class="eyebrow">{t.education.eyebrow}</p>
      <h2 class="section-title mt-3">{t.education.title}</h2>
      <div class="mt-12 grid gap-10 lg:grid-cols-2">
        <div class="space-y-4">
          {t.education.items.map((e) => (
            <article class="flex items-start justify-between gap-4 border-b border-line pb-4">
              <div>
                <h3 class="font-display text-xl font-medium">{e.title}</h3>
                <p class="text-sm text-sky font-medium">{e.org}</p>
                <p class="mt-1 text-sm text-muted">{e.detail}</p>
              </div>
              <p class="shrink-0 text-sm text-muted">{e.year}</p>
            </article>
          ))}
          <div class="rounded-2xl bg-accent-soft p-5">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent">{t.education.next.title}</p>
            <p class="mt-2 font-display text-lg text-ink">{t.education.next.text}</p>
          </div>
        </div>
        <div>
          <h3 class="text-sm font-semibold uppercase tracking-[0.14em] text-muted">{t.education.coursesTitle}</h3>
          <ul class="mt-4 space-y-3">
            {t.education.courses.map((c) => (
              <li class="flex items-center gap-4 rounded-xl border border-line bg-card p-4">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-paper text-sky ring-1 ring-line" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 10 12 5 2 10l10 5 10-5Z"/><path d="M6 12v5c3 2 9 2 12 0v-5"/></svg>
                </span>
                <div>
                  <p class="font-medium leading-snug">{c.title}</p>
                  <p class="text-sm text-muted">{c.org}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- HABILIDADES -->
  <section class="print-tight border-t border-line bg-card">
    <div class="mx-auto max-w-6xl px-4 py-16 md:px-8 md:py-24">
      <p class="eyebrow">{t.skills.eyebrow}</p>
      <h2 class="section-title mt-3">{t.skills.title}</h2>
      <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {t.skills.groups.map((g) => (
          <div>
            <h3 class="border-b border-ink pb-2 font-display text-lg font-medium">{g.title}</h3>
            <ul class="mt-4 space-y-2 text-[15px] text-muted">
              {g.items.map((s) => <li>{s}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTATO -->
  <section id="contato" class="print-tight scroll-mt-20 bg-ink text-paper">
    <div class="mx-auto max-w-6xl px-4 py-16 md:px-8 md:py-24">
      <div class="grid gap-10 lg:grid-cols-[1.2fr_1fr] lg:items-end">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent">{t.contactSection.eyebrow}</p>
          <h2 class="mt-3 font-display text-4xl font-medium tracking-tight md:text-5xl">{t.contactSection.title}</h2>
          <p class="mt-4 max-w-lg text-white/70">{t.contactSection.text}</p>
        </div>
        <div>
          <a href={contact.linkedin} target="_blank" rel="noopener" class="group flex items-center justify-between gap-4 rounded-2xl bg-white/5 p-5 ring-1 ring-white/15 transition hover:bg-white/10 hover:ring-white/30">
            <span class="flex items-center gap-4">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-[#0a66c2] text-white"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/></svg></span>
              <span>
                <span class="block font-medium">{t.contactSection.linkedinCta}</span>
                <span class="block text-sm text-white/55 break-all">{contact.linkedin.replace(/^https?:\/\/(www\.)?/, '')}</span>
              </span>
            </span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="no-print shrink-0 transition group-hover:translate-x-1" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <p class="mt-4 text-sm leading-relaxed text-white/55">{t.contactSection.linkedinNote}</p>
          <p class="mt-6 flex items-center justify-between gap-4 border-t border-white/10 pt-4"><span class="text-sm text-white/55">{t.contactSection.city}</span><span class="font-medium">{contact.city}</span></p>
        </div>
      </div>
      <p class="mt-16 text-xs text-white/40">© {new Date().getFullYear()} {contact.name} · {t.footer}</p>
    </div>
  </section>
</main>

<script>
  document.querySelectorAll('[data-print]').forEach((b) => b.addEventListener('click', () => window.print()));
</script>
